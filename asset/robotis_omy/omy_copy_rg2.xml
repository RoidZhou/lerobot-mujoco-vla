                      quat="0.947655 0 -0.319297 0" mass="0.0110931"
                      diaginertia="5.59353e-06 3.96549e-06 1.88108e-06" />
                    <geom name="ur_rg2_gripper_finger2_finger_link_collision" type="mesh" contype="0" conaffinity="1" rgba="0.5 0.5 0.5 1"
