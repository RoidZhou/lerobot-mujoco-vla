                  <!-- Finger -->
                  <body name="rg2_gripper_finger1_finger_link" pos="0.0169 0.0103 0.105"
                    quat="0 0 0 1">
                    <inertial pos="0.0170975 -3.93809e-10 0.0224918"
                      quat="0.947655 0 -0.319297 0" mass="0.0110931"
                      diaginertia="5.59353e-06 3.96549e-06 1.88108e-06" />
