    <geom name="ground" type="plane" pos="0 0 0" size="100 100 0.001" quat="1 0 0 0" material="matplane" condim="3" conaffinity="15" />
    <camera name="fixed" pos="0 -3.0 0.5677029378712177" xyaxes="1 0 0 0 0 1" />
    <camera name="track" mode="trackcom" pos="0 -3.0 0.5677029378712177" xyaxes="1 0 0 0 0 1" />
    <body name="root" pos="0 0 0.06770293787121773" quat="1 0 0 0">
      <freejoint name="root" />
      <site name="imu" size="0.01" pos="0 0 0" />
      <geom name="base_link_collision" type="mesh" mesh="base" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
      <geom type="mesh" rgba="0.2 0.2 0.2 1" mesh="base" />
      <body name="shoulder_link" pos="0 0 0.089159">
        <joint name="shoulder_pan_joint" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319" actuatorfrcrange="-150 150" />
        <geom name="shoulder_link_collision" type="mesh" mesh="shoulder" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
        <geom type="mesh" rgba="0.2 0.2 0.2 1" mesh="shoulder" />
        <body name="upper_arm_link" pos="0 0.13585 0">
          <joint name="shoulder_lift_joint" pos="0 0 0" axis="0 1 0" range="-6.28319 6.28319" actuatorfrcrange="-150 150" />
          <geom name="upper_arm_link_collision" type="mesh" mesh="upperarm" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
          <geom type="mesh" rgba="0.2 0.2 0.2 1" mesh="upperarm" />
          <body name="forearm_link" pos="0 -0.1197 0.425">
            <joint name="elbow_joint" pos="0 0 0" axis="0 1 0" range="-6.28319 6.28319" actuatorfrcrange="-150 150" />
            <geom name="forearm_link_collision" type="mesh" mesh="forearm" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
            <geom type="mesh" rgba="0.2 0.2 0.2 1" mesh="forearm" />
            <body name="wrist_1_link" pos="0 0 0.39225">
              <joint name="wrist_1_joint" pos="0 0 0" axis="0 1 0" range="-6.28319 6.28319" actuatorfrcrange="-28 28" />
              <geom name="wrist_1_link_collision" type="mesh" mesh="wrist1" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
              <geom type="mesh" rgba="0.2 0.2 0.2 1" mesh="wrist1" />
              <body name="wrist_2_link" pos="0 0.093 0">
                <joint name="wrist_2_joint" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319" actuatorfrcrange="-28 28" />
